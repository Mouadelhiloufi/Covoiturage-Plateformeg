{
  "info": {
    "name": "Covoiturage API",
    "description": "Collection Postman pour tester l'API Spring Boot de covoiturage.\n\nBase URL locale: http://localhost:8087\n\nOrdre conseille:\n1. Creer un conducteur\n2. Creer un passager\n3. Creer un vehicule avec l'identifiant du conducteur\n4. Tester les routes GET, PUT, SEARCH et DELETE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8087" },
    { "key": "conducteurId", "value": "1" },
    { "key": "passagerId", "value": "1" },
    { "key": "vehiculeId", "value": "1" }
  ],
  "item": [
    {
      "name": "Conducteurs",
      "description": "Gestion des conducteurs.",
      "item": [
        {
          "name": "Creer un conducteur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"El Hiloufi\",\n  \"prenom\": \"Mouad\",\n  \"email\": \"mouad.elhiloufi@example.com\",\n  \"telephone\": \"0600000001\",\n  \"numeroPermis\": \"PERMIS-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/conducteurs"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.collectionVariables.set(\"conducteurId\", body.id);"
              ]
            }
          }]
        },
        {
          "name": "Lister les conducteurs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conducteurs?page=0&size=10&sort=nom,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conducteurs"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "nom,asc" }
              ]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test(\"Code HTTP 200\", function () { pm.response.to.have.status(200); });"] }
          }]
        },
        {
          "name": "Obtenir un conducteur",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/conducteurs/{{conducteurId}}"
          }
        },
        {
          "name": "Rechercher des conducteurs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conducteurs/search?q=Mouad&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conducteurs", "search"],
              "query": [
                { "key": "q", "value": "Mouad" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Modifier un conducteur",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"El Hiloufi\",\n  \"prenom\": \"Mouad\",\n  \"email\": \"mouad.elhiloufi@youcode.ma\",\n  \"telephone\": \"0600000001\",\n  \"numeroPermis\": \"PERMIS-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/conducteurs/{{conducteurId}}"
          }
        }
      ]
    },
    {
      "name": "Passagers",
      "description": "Gestion des passagers.",
      "item": [
        {
          "name": "Creer un passager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Alaoui\",\n  \"prenom\": \"Sara\",\n  \"email\": \"sara.alaoui@example.com\",\n  \"telephone\": \"0600000002\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/passagers"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.collectionVariables.set(\"passagerId\", body.id);"
              ]
            }
          }]
        },
        {
          "name": "Lister les passagers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/passagers?page=0&size=10&sort=nom,asc"
          }
        },
        {
          "name": "Obtenir un passager",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/passagers/{{passagerId}}"
          }
        },
        {
          "name": "Rechercher des passagers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/passagers/search?q=Sara&page=0&size=10"
          }
        },
        {
          "name": "Modifier un passager",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Alaoui\",\n  \"prenom\": \"Sara\",\n  \"email\": \"sara.alaoui@youcode.ma\",\n  \"telephone\": \"0600000002\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/passagers/{{passagerId}}"
          }
        }
      ]
    },
    {
      "name": "Vehicules",
      "description": "Gestion des vehicules. La creation exige un conducteur existant.",
      "item": [
        {
          "name": "Ajouter un vehicule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marque\": \"Renault\",\n  \"modele\": \"Clio\",\n  \"immatriculation\": \"1234-A-1\",\n  \"couleur\": \"Bleu\",\n  \"capacite\": 4,\n  \"conducteurId\": {{conducteurId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/vehicules"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test(\"Code HTTP 201\", function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.collectionVariables.set(\"vehiculeId\", body.id);"
              ]
            }
          }]
        },
        {
          "name": "Obtenir un vehicule",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vehicules/{{vehiculeId}}"
          }
        },
        {
          "name": "Lister les vehicules d'un conducteur",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vehicules/conducteur/{{conducteurId}}"
          }
        },
        {
          "name": "Modifier un vehicule",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marque\": \"Renault\",\n  \"modele\": \"Clio 5\",\n  \"immatriculation\": \"1234-A-1\",\n  \"couleur\": \"Noir\",\n  \"capacite\": 5,\n  \"conducteurId\": {{conducteurId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/vehicules/{{vehiculeId}}"
          }
        },
        {
          "name": "Supprimer un vehicule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicules/{{vehiculeId}}?conducteurId={{conducteurId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicules", "{{vehiculeId}}"],
              "query": [{ "key": "conducteurId", "value": "{{conducteurId}}" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test(\"Code HTTP 204\", function () { pm.response.to.have.status(204); });"] }
          }]
        }
      ]
    }
  ]
}
